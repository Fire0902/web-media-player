# Copy this file to .env at the repo root before running docker compose.
# `docker compose` picks up .env automatically.

# ── Required ─────────────────────────────────────────────────────────────────
# AdonisJS application key — must be at least 16 characters.
# Generate with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
APP_KEY=change-me-to-a-real-32-char-secret

# ── Optional ─────────────────────────────────────────────────────────────────
# Where the SPA is published on the host (prod only).
HTTP_PORT=80

# Path on the host that contains your video library (prod only).
# Mounted read-only into the api container at /app/media.
MEDIA_DIR=./hedgehog_api/media

# Server timezone and log verbosity.
TZ=UTC
LOG_LEVEL=info
